---
import { getCollection, render, type CollectionEntry } from "astro:content";
import AiUsageNotice from "../../components/AiUsageNotice.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("works", ({ data }) => !data.draft)).toSorted(
    (left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime() || left.id.localeCompare(right.id, "pt-BR"),
  );
  const root = "/trabalhos";
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      older: entries[index + 1] ? { id: entries[index + 1].id, title: entries[index + 1].data.title } : null,
      newer: entries[index - 1] ? { id: entries[index - 1].id, title: entries[index - 1].data.title } : null,
      root,
    },
  }));
}

interface RelatedEntry { id: string; title: string }
interface Props { entry: CollectionEntry<"works">; older: RelatedEntry | null; newer: RelatedEntry | null; root: string }
const { entry, older, newer, root } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base.slice(0, -1) : base;
const hrefFor = (item: RelatedEntry | null) => item ? { href: `${basePath}${root}/${item.id}/`, title: item.title } : null;
const artifactHref = entry.data.artifact ? `${basePath}${entry.data.artifact}` : null;
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  publishedAt={entry.data.publishedAt}
  category={entry.data.type}
  structuredDataType="Article"
  status={entry.data.status}
  tags={entry.data.tags}
  headings={headings}
  revisions={entry.data.revisions}
  older={hrefFor(older)}
  newer={hrefFor(newer)}
>
  <dl slot="metadata" class="content-facts">
    <div><dt>Prazo</dt><dd><time datetime={entry.data.dueAt.toISOString()}>{entry.data.dueAt.toLocaleDateString("pt-BR", { timeZone: "America/Sao_Paulo" })}</time></dd></div>
    <div><dt>Semana</dt><dd>{entry.data.courseWeek}</dd></div>
    {artifactHref && <div><dt>Artefato</dt><dd><a href={artifactHref}>Abrir artefato</a></dd></div>}
  </dl>
  <Content />
  <AiUsageNotice slot="notice" statement={entry.data.aiUsage} />
</ContentLayout>
