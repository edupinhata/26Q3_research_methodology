---
import { formatPublishedDate } from "../../utils/homepage";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  kind: string;
  href?: string;
  status?: string;
  tags?: string[];
}

const { title, description, publishedAt, kind, href, status, tags = [] } = Astro.props;
const formattedDate = formatPublishedDate(publishedAt);
---

<article class="content-card">
  <p class="content-meta">{kind}{status ? ` · ${status}` : ""} · <time datetime={publishedAt.toISOString()}>{formattedDate}</time></p>
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <p>{description}</p>
  {tags.length > 0 && <ul class="card-tags" aria-label="Tags">{tags.map((tag) => <li>{tag}</li>)}</ul>}
</article>

<style>
  .content-card {
    height: 100%;
    padding: var(--space-5);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .content-meta {
    color: var(--color-primary);
    font-size: var(--step--1);
    font-weight: 750;
    text-transform: capitalize;
  }

  h3 {
    font-size: var(--step-1);
  }

  h3 a {
    color: inherit;
    text-decoration-color: var(--color-accent);
  }

  p:last-of-type {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .card-tags li {
    padding: var(--space-1) var(--space-2);
    border-radius: 999px;
    background: var(--color-primary-soft);
    font-size: var(--step--1);
  }
</style>
