---
import { getCollection } from "astro:content";
import ContentIndex from "../../components/ContentIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { selectPublishedContent, type AcademicContent } from "../../utils/content";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base.slice(0, -1) : base;
const sourceEntries = await getCollection("notes");
const entries: Array<AcademicContent & { href: string }> = selectPublishedContent(
  sourceEntries.map((entry) => ({
    id: entry.id,
    href: `${basePath}/anotacoes/${entry.id}/`,
    data: {
      title: entry.data.title,
      description: entry.data.description,
      publishedAt: entry.data.publishedAt,
      tags: entry.data.tags,
      draft: entry.data.draft,
      category: entry.data.kind,
      status: entry.data.status,
    },
  })),
);
---

<BaseLayout title="Anotações de pesquisa — CCM-002" description="Registros de aulas, questões em aberto e conexões construídas ao longo da disciplina.">
  <ContentIndex
    eyebrow="Caderno de pesquisa"
    title="Anotações de pesquisa"
    introduction="Registros de aulas, questões em aberto e conexões construídas ao longo da disciplina."
    emptyMessage="Nenhuma anotação publicada ainda."
    entries={entries}
  />
</BaseLayout>
