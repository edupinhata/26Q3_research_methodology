---
import { getCollection } from "astro:content";
import ContentIndex from "../../components/ContentIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { selectPublishedContent, type AcademicContent } from "../../utils/content";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base.slice(0, -1) : base;
const sourceEntries = await getCollection("library");
const entries: Array<AcademicContent & { href: string }> = selectPublishedContent(
  sourceEntries.map((entry) => ({
    id: entry.id,
    href: `${basePath}/biblioteca/${entry.id}/`,
    data: {
      title: entry.data.title,
      description: entry.data.description,
      publishedAt: entry.data.publishedAt,
      tags: entry.data.tags,
      draft: entry.data.draft,
      category: entry.data.kind,
      status: entry.data.status,
    },
  })),
);
---

<BaseLayout title="Biblioteca comentada — CCM-002" description="Artigos, livros, vídeos e recursos acompanhados de comentários críticos e referências.">
  <ContentIndex
    eyebrow="Leituras comentadas"
    title="Biblioteca comentada"
    introduction="Artigos, livros, vídeos e recursos acompanhados de comentários críticos e referências."
    emptyMessage="Nenhuma leitura publicada ainda."
    entries={entries}
  />
</BaseLayout>
