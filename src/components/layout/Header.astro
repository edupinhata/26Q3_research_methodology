---
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base.slice(0, -1) : base;
const currentPath = Astro.url.pathname;
const repositoryUrl = "https://github.com/edupinhata/26Q3_research_methodology";
---

<header class="site-header">
  <a class="brand" href={base} aria-label="CCM-002 — página inicial">
    <span class="brand-mark" aria-hidden="true">M</span>
    <span>CCM-002</span>
  </a>

  <nav class="primary-nav" aria-label="Navegação principal">
    <ul>
      <li>
        <a href={base} aria-current={currentPath === base || currentPath === `${base}/` ? "page" : undefined}>
          Início
        </a>
      </li>
      <li>
        <a href={`${basePath}/disciplina/`} aria-current={currentPath === `${basePath}/disciplina/` ? "page" : undefined}>
          Disciplina
        </a>
      </li>
      <li>
        <a href={`${basePath}/timeline/`} aria-current={currentPath === `${basePath}/timeline/` ? "page" : undefined}>
          Timeline
        </a>
      </li>
      <li>
        <a href={`${basePath}/trabalhos/`} aria-current={currentPath.startsWith(`${basePath}/trabalhos/`) ? "page" : undefined}>
          Trabalhos
        </a>
      </li>
      <li>
        <a href={`${basePath}/anotacoes/`} aria-current={currentPath.startsWith(`${basePath}/anotacoes/`) ? "page" : undefined}>
          Anotações
        </a>
      </li>
      <li>
        <a href={`${basePath}/biblioteca/`} aria-current={currentPath.startsWith(`${basePath}/biblioteca/`) ? "page" : undefined}>
          Biblioteca
        </a>
      </li>
      <li>
        <a href={`${basePath}/codigo/`} aria-current={currentPath.startsWith(`${basePath}/codigo/`) ? "page" : undefined}>
          Código
        </a>
      </li>
      <li>
        <a href={repositoryUrl} rel="external">Repositório</a>
      </li>
    </ul>
  </nav>
</header>
