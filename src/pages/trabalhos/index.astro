---
import { getCollection } from "astro:content";
import ContentIndex from "../../components/ContentIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { selectPublishedContent, type AcademicContent } from "../../utils/content";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base.slice(0, -1) : base;
const sourceEntries = await getCollection("works");
const entries: Array<AcademicContent & { href: string }> = selectPublishedContent(
  sourceEntries.map((entry) => ({
    id: entry.id,
    href: `${basePath}/trabalhos/${entry.id}/`,
    data: {
      title: entry.data.title,
      description: entry.data.description,
      publishedAt: entry.data.publishedAt,
      tags: entry.data.tags,
      draft: entry.data.draft,
      category: entry.data.type,
      status: entry.data.status,
    },
  })),
);
---

<BaseLayout title="Trabalhos acadêmicos — CCM-002" description="Resumos, revisão de literatura, pré-projeto e apresentações com contexto, processo e aprendizados.">
  <ContentIndex
    eyebrow="Portfólio acadêmico"
    title="Trabalhos acadêmicos"
    introduction="Resumos, revisão de literatura, pré-projeto e apresentações com contexto, processo e aprendizados."
    emptyMessage="Nenhum trabalho publicado ainda."
    entries={entries}
  />
</BaseLayout>
