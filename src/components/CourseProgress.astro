---
import { formatCourseDate } from "../utils/dates";
import type { CourseProgress as CourseProgressValue } from "../utils/progress";

interface Props {
  progress: CourseProgressValue;
  courseStartsOn: string;
  courseEndsOn: string;
}

const { progress, courseStartsOn, courseEndsOn } = Astro.props;
---

<section class="progress-card" aria-labelledby="progress-title">
  <p class="card-kicker">Andamento</p>
  <h2 id="progress-title">Progresso das entregas</h2>
  <p class="progress-value">
    <strong>{progress.percentage}%</strong>
    <span>{progress.completed} de {progress.total} concluídas</span>
  </p>
  <progress
    aria-label="Progresso das entregas"
    value={progress.completed}
    max={progress.total || 1}
  >
    {progress.percentage}%
  </progress>
  <p class="period">
    Período: <time datetime={courseStartsOn}>{formatCourseDate(courseStartsOn)}</time>{" "}a{" "}
    <time datetime={courseEndsOn}>{formatCourseDate(courseEndsOn)}</time>.
  </p>
</section>

<style>
  .progress-card {
    padding: var(--space-6);
    border: var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .card-kicker {
    margin-block-end: var(--space-3);
    color: var(--color-primary);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--step-1);
  }

  .progress-value {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-ink-soft);
    font-size: var(--step--1);
  }

  .progress-value strong {
    color: var(--color-primary-strong);
    font-family: var(--font-heading);
    font-size: var(--step-2);
  }

  progress {
    width: 100%;
    height: 0.8rem;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background: var(--color-surface-muted);
  }

  progress::-webkit-progress-bar {
    background: var(--color-surface-muted);
  }

  progress::-webkit-progress-value {
    background: var(--color-accent);
  }

  progress::-moz-progress-bar {
    background: var(--color-accent);
  }

  .period {
    margin-block: var(--space-4) 0;
    color: var(--color-ink-soft);
    font-size: var(--step--1);
  }
</style>
