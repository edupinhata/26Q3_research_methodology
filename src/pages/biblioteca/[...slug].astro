---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("library", ({ data }) => !data.draft)).toSorted(
    (left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime() || left.id.localeCompare(right.id, "pt-BR"),
  );
  return entries.map((entry, index) => ({ params: { slug: entry.id }, props: {
    entry,
    older: entries[index + 1] ? { id: entries[index + 1].id, title: entries[index + 1].data.title } : null,
    newer: entries[index - 1] ? { id: entries[index - 1].id, title: entries[index - 1].data.title } : null,
  }}));
}
interface RelatedEntry { id: string; title: string }
interface Props { entry: CollectionEntry<"library">; older: RelatedEntry | null; newer: RelatedEntry | null }
const { entry, older, newer } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base.slice(0, -1) : base;
const hrefFor = (item: RelatedEntry | null) => item ? { href: `${basePath}/biblioteca/${item.id}/`, title: item.title } : null;
---
<ContentLayout title={entry.data.title} description={entry.data.description} publishedAt={entry.data.publishedAt}
  category={entry.data.kind} structuredDataType="WebPage" status={entry.data.status} tags={entry.data.tags} headings={headings}
  revisions={entry.data.revisions} older={hrefFor(older)} newer={hrefFor(newer)}>
  <dl slot="metadata" class="content-facts">
    {entry.data.authors.length > 0 && <div><dt>Autoria</dt><dd>{entry.data.authors.join(", ")}</dd></div>}
    {entry.data.sourceUrl && <div><dt>Fonte</dt><dd><a href={entry.data.sourceUrl} rel="external noreferrer">Consultar fonte</a></dd></div>}
  </dl>
  <Content />
</ContentLayout>
