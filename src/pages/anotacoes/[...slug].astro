---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("notes", ({ data }) => !data.draft)).toSorted(
    (left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime() || left.id.localeCompare(right.id, "pt-BR"),
  );
  return entries.map((entry, index) => ({ params: { slug: entry.id }, props: {
    entry,
    older: entries[index + 1] ? { id: entries[index + 1].id, title: entries[index + 1].data.title } : null,
    newer: entries[index - 1] ? { id: entries[index - 1].id, title: entries[index - 1].data.title } : null,
  }}));
}
interface RelatedEntry { id: string; title: string }
interface Props { entry: CollectionEntry<"notes">; older: RelatedEntry | null; newer: RelatedEntry | null }
const { entry, older, newer } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base.slice(0, -1) : base;
const hrefFor = (item: RelatedEntry | null) => item ? { href: `${basePath}/anotacoes/${item.id}/`, title: item.title } : null;
---
<ContentLayout title={entry.data.title} description={entry.data.description} publishedAt={entry.data.publishedAt}
  category={entry.data.kind} status={entry.data.status} tags={entry.data.tags} headings={headings}
  revisions={entry.data.revisions} older={hrefFor(older)} newer={hrefFor(newer)}>
  {entry.data.courseWeek && <p slot="metadata" class="content-week">Semana da disciplina: <strong>{entry.data.courseWeek}</strong></p>}
  <Content />
</ContentLayout>
